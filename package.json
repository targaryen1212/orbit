{
  "name": "orbit-protocol",
  "version": "0.4.0",
  "private": true,
  "description": "Schemas and a TypeScript SDK for user-owned saved content.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "check": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "example:local": "npm -w @orbb/orbit-example run start"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
