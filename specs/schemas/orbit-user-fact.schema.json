{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orbit.dev/schemas/orbit-user-fact.schema.json",
  "title": "OrbitUserFact",
  "type": "object",
  "required": ["schemaVersion", "id", "ownerId", "content", "source", "createdAt"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "orbit.user_fact.v0" },
    "id": { "type": "string" },
    "ownerId": { "type": "string" },
    "content": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "enum": ["explicit", "conversation", "import", "inference"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "status": { "type": "string", "enum": ["active", "archived", "deleted"] },
    "metadata": { "type": "object", "additionalProperties": true },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
